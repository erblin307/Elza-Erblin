# Configure an authorized raster tile source before production deployment.
# Values are public browser configuration, never private credentials.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION_TEXT=
VITE_MAP_ATTRIBUTION_URL=
VITE_MAP_MAX_ZOOM=19

# Public browser Geoapify key for Places, accommodation and Routing API requests.
# Restrict allowed origins/referrers and quotas.
VITE_GEOAPIFY_API_KEY=
# Wikimedia application contact URL/email for the Api-User-Agent header.
VITE_WIKIMEDIA_CONTACT=

# Accommodation discovery and transportation routing reuse VITE_GEOAPIFY_API_KEY;
# no separate keys are introduced.
# Commercial inventory is not connected. Never put partner secrets in VITE_ variables.

# Public URL for a secured server-side flight integration. The endpoint must keep
# DUFFEL_ACCESS_TOKEN (or another provider secret) on the server and return the
# normalized airport/offer contract documented in FLIGHTS_AND_LONG_DISTANCE_TRANSPORT.md.
VITE_FLIGHT_SEARCH_ENDPOINT=
# Never create VITE_DUFFEL_ACCESS_TOKEN: VITE_ values are shipped to the browser.
